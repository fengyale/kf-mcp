# 把本文件复制为 gitlab-mcp.env（放 server.js 同目录），服务启动时会自动加载。
# 进程已有的环境变量优先级高于本文件，因此客户端配置里填了 env 时以客户端为准。
# 注意：本文件含明文 token，请勿提交到代码仓库；打包分发时必须排除本文件。

# ---- GitLab 地址（带不带 /api/v4 都能识别）----
GITLAB_API_URL=http://your-gitlab.example.com/api/v4

# ---- 访问令牌 ----
# 强烈建议只勾选 read_api（只读）。只读 token 会让写操作在 GitLab 服务端被直接拒绝，
# 这是唯一真正的安全边界 —— 客户端开关只是减少误触，不能替代它。
GITLAB_PERSONAL_ACCESS_TOKEN=在此填写你的PersonalAccessToken

# ---- 单次请求超时（毫秒），默认 30000 ----
GITLAB_TIMEOUT_MS=30000

# ---- 只读模式 ----
# 默认开启：留空 / 1 / true 均表示只读，此时 7 个写工具不会被下发，直接调用也会被拒绝。
# 只有显式设为 0 / false / no / off 才启用写操作 —— 启用前请确认 token 权限，
# 并清楚写操作（尤其合并 MR）可能触发流水线、发出通知邮件，且不可撤回。
GITLAB_READONLY=1
